rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mirror of isAdmin() in firestore.rules — the admin address is hardcoded
    // in both files and must be changed in both together.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'bagpackerme.world@gmail.com';
    }

    // Every upload surface in the admin panel is accept="image/*".
    // Only valid on create/update — request.resource is null on delete.
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Package, blog, and gallery images are served publicly on the marketing
    // site; only the admin may add or replace them.
    match /packages/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }
    match /blogs/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }

    // Anything outside the three known prefixes is not writable at all.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
