rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mirror of isAdmin() in firestore.rules — the admin address is hardcoded
    // in both files and must be changed in both together.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'bagpackerme.world@gmail.com';
    }

    // Every upload surface in the admin panel is accept="image/*".
    // Only valid on create/update — request.resource is null on delete.
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Package, blog, and gallery images are served publicly on the marketing
    // site; only the admin may add or replace them.
    match /packages/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }
    match /blogs/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }

    // Candidate CVs. Denied to everyone here, on purpose: the only writer is the
    // Admin SDK in app/api/careers/apply/route.ts and the only reader is
    // app/api/admin/applications/[id]/cv/route.ts, which streams the bytes after
    // verifying the admin session cookie. Both bypass these rules entirely.
    //
    // This block is what keeps CVs private. The catch-all below grants
    // `read: if true`, and Storage rules do not cascade the way Firestore's do —
    // the most specific match wins outright — so without this match a resume
    // would be downloadable by anyone who learned its path. Do not remove it
    // without moving CVs to a different bucket.
    match /applications/{allPaths=**} {
      allow read, write: if false;
    }

    // Anything outside the known prefixes is not writable at all.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
