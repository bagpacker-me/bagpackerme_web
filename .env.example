# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are exposed to the
# browser by design — they are not secrets. FIREBASE_SERVICE_ACCOUNT_KEY is a
# real secret and must never be prefixed with NEXT_PUBLIC_.

# ── Firebase client config ────────────────────────────────────────────────────
# Firebase Console > Project Settings > General > Your apps > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Admin ─────────────────────────────────────────────────────────────────────
# The single address allowed into /admin.
#
# IMPORTANT: this address is also hardcoded in firestore.rules and
# storage.rules (isAdmin()). Changing it here alone will let someone reach the
# admin UI while every Firestore read and write silently fails. Change all
# three together and redeploy rules:
#   firebase deploy --only firestore:rules,storage
NEXT_PUBLIC_ADMIN_EMAIL=

# ── Firebase Admin SDK credentials ────────────────────────────────────────────
# There is no service account key. Key creation is blocked on this project by
# the org policy iam.disableServiceAccountKeyCreation, and long-lived keys are
# the most commonly leaked cloud credential regardless. Two keyless paths:
#
# LOCAL DEV — nothing below is needed. Run once:
#     gcloud auth application-default login
#   firebase-admin picks the credential up via applicationDefault().
#
# VERCEL — Workload Identity Federation. Vercel mints a short-lived OIDC token
#   per invocation and GCP exchanges it for a short-lived access token, so no
#   secret is ever stored. Setup: https://vercel.com/docs/oidc/gcp
#   Requires "Secure Backend Access" (OIDC) enabled on the Vercel project.
#
# None of these are secrets — they are identifiers, safe to commit if you want.
# Set them in Vercel only; local dev uses ADC and ignores them.
#
# Value                              Where to find it
# ---------------------------------  ------------------------------------------
# GCP_PROJECT_NUMBER                 IAM & Admin > Settings
# GCP_SERVICE_ACCOUNT_EMAIL          IAM & Admin > Service Accounts
# GCP_WORKLOAD_IDENTITY_POOL_ID      IAM & Admin > Workload Identity Federation
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID   ...same page, under Providers
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
