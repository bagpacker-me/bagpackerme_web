rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: check if user is authenticated admin.
    // Mirrored in storage.rules — change both together.
    //
    // This address must stay in step with NEXT_PUBLIC_ADMIN_EMAIL in Vercel.
    // When the two drift, the panel still renders — middleware, useAuth and
    // /api/auth/session all gate on the env var — while every read here is
    // denied, which reads as "the admin panel is broken" rather than as a
    // config mismatch.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'admin@bagpackerme.com';
    }

    // Shape guard for the public newsletter signup. subscribeToNewsletter()
    // writes exactly these two fields from the browser.
    function isSubscriberDoc(data) {
      return data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.createdAt is string
        && data.createdAt.size() <= 40;
    }

    // Packages: public can read published, only admin can write
    match /packages/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Blogs: public can read published, only admin can write
    match /blogs/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Enquiries: created server-side only, via the Admin SDK in
    // lib/enquiry-submission.ts (contact, package-booking, enquiries routes).
    // The Admin SDK bypasses these rules, so browsers get no write access at
    // all and the zod validation in those routes cannot be sidestepped.
    match /enquiries/{docId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Subscribers: the newsletter forms (Footer, NewsletterSection,
    // NewsletterCard) write these directly from the browser, so create stays
    // public — but shape-validated.
    match /subscribers/{docId} {
      allow create: if isSubscriberDoc(request.resource.data);
      allow read, delete: if isAdmin();
    }

    // Job openings: public can read published, only admin can write.
    // Mirrors packages/blogs — /careers lists where status == 'published'.
    match /job_openings/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Job applications: created server-side only, via the Admin SDK in
    // app/api/careers/apply/route.ts. The Admin SDK bypasses these rules, so
    // browsers get no write access at all and neither the zod validation nor
    // the CV magic-byte checks in that route can be sidestepped.
    //
    // Candidate PII (name, email, phone, CV) is never publicly readable. The CV
    // itself lives in Storage under applications/, denied to everyone by
    // storage.rules and served only by the admin download route.
    match /job_applications/{docId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Curious Club applications: created server-side only, via the Admin SDK in
    // app/api/curious-club/apply/route.ts. The Admin SDK bypasses these rules,
    // so browsers get no write access at all and the zod validation in that
    // route — including the "pick up to 5" / "choose up to 3" caps and the
    // required consent flag — cannot be sidestepped.
    //
    // Applicant PII (name, city, phone, email, socials and long free-text
    // answers) is never publicly readable. Mirrors job_applications above.
    match /club_applications/{docId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Settings: public can read, only admin can write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customers: admin only
    match /customers/{docId} {
      allow read, write: if isAdmin();
    }

    // Bookings: admin only
    match /bookings/{docId} {
      allow read, write: if isAdmin();
    }

    // Gallery: admin only
    match /gallery/{docId} {
      allow read, write: if isAdmin();
    }

    // Testimonials: public can read published, only admin can write.
    // Mirrors packages/blogs — the homepage lists where status == 'published'.
    match /testimonials/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Affiliates: private records (email, commissionRate, notes). Registration
    // goes through the Admin SDK in lib/affiliate-admin.ts, so no public create.
    match /affiliates/{docId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Public-safe affiliate mirror. No anonymous read: /affiliate/dashboard
    // reaches this through /api/affiliate/[code], which uses the Admin SDK
    // (getAffiliateDashboardAdmin) and so bypasses these rules. Granting
    // `read: if true` here would also permit a *list*, letting anyone
    // enumerate every affiliate by name — the dashboard never needed that,
    // since it looks up one code at a time through the route.
    //
    // Writes come from either the Admin SDK (registration, click tracking,
    // conversions — bypasses rules) or the admin panel, which syncs this doc
    // from the browser when an affiliate's status changes.
    match /affiliate_public/{affiliateCode} {
      allow read: if isAdmin();
      allow write: if isAdmin();

      match /events/{sessionId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    // Duplicate-check index for affiliate registration. Created only by the
    // Admin SDK; public create previously allowed anyone to pre-register a
    // victim's email hash and permanently block their signup.
    // Delete stays open to the admin: deleteAffiliate() batch-deletes this doc
    // from the admin panel, and a batch fails atomically if any write is denied.
    match /affiliate_registration_index/{emailHash} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Legacy affiliate clicks: admin-only access
    match /affiliate_clicks/{docId} {
      allow read, update, delete: if isAdmin();
    }
  }
}
